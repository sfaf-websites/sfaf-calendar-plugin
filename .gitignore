# ---------------------------------------------------------------------------
# Credentials / secrets — never commit
# ---------------------------------------------------------------------------
.env
.env.*
*.env
env.php
wp-config.php
wp-config-local.php
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*
*credentials*.json
auth.json

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Dependencies / build
# ---------------------------------------------------------------------------
node_modules/
vendor/
bower_components/
jspm_packages/
*.log
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Editor / IDE folders
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.komodoproject
.buildpath
.project
.settings/
nbproject/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# WordPress runtime (in case this tree is ever dropped into a full install)
# ---------------------------------------------------------------------------
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
*.sql
*.sqlite

# ---------------------------------------------------------------------------
# Archives — original deliveries kept locally as reference only.
# Extracted folders + git history preserve the original state; zips can't be
# diffed and would only add weight.
# ---------------------------------------------------------------------------
*.zip
