# SFAF Calendar: how long a browser may keep the plugin's scripts (3.112.1,
# plain directives since 3.112.2).
#
# The loader and the version file are kept five minutes. Every other script is
# kept a day; each is asked for with ?ver=, which moves with every release.
#
# Only where the server reads this file. resources.sfaf.org runs LiteSpeed,
# which reads .htaccess, but nothing depends on it: the loader asks for the
# version file under a new address every five minutes whatever is cached. No
# <If> expressions, which LiteSpeed does not fully support, and every directive
# is guarded, so a server without mod_headers skips it rather than refusing
# the folder.
<IfModule mod_headers.c>
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "^embed(-version)?\.js$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
</IfModule>
