# SFAF Calendar: how long a browser may keep the plugin's scripts (3.112.1).
#
# embed.js is the loader every pasted snippet names. It holds no release logic,
# so a kept copy is harmless, but it is kept briefly anyway.
# A script asked for with ?ver= is that release's file and never changes, so it
# may be kept for a year. Anything else is kept briefly.
#
# Only where Apache reads this file. A host that serves static files from
# nginx, as WP Engine may, ignores it; the loader does not depend on it.
# Every directive is guarded, so a server without these modules skips it
# rather than refusing the folder.
<IfModule mod_headers.c>
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
    <IfModule mod_version.c>
        <IfVersion >= 2.4>
            <If "%{QUERY_STRING} =~ /(^|&)ver=/ && %{REQUEST_URI} =~ m#\.js$# && %{REQUEST_URI} !~ m#/embed\.js$#">
                Header set Cache-Control "public, max-age=31536000, immutable"
            </If>
        </IfVersion>
    </IfModule>
</IfModule>
